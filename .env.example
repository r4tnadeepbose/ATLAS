# ---------------------------------------------------------------------------
# ATLAS runtime configuration
# Copy to .env and replace every change-me value before any non-local use.
# ---------------------------------------------------------------------------

ATLAS_APP_NAME=ATLAS
ATLAS_APP_ENV=development
ATLAS_DEBUG=false

# 48+ random bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_SECRET_KEY=change-me-generate-a-48-byte-random-signing-key
ATLAS_ACCESS_TOKEN_MINUTES=60
ATLAS_REFRESH_TOKEN_DAYS=7

# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
ATLAS_DATABASE_URL=sqlite:///./atlas.db
ATLAS_DB_ECHO=false

# Optional infrastructure. Leave blank to run in single-process mode.
ATLAS_REDIS_URL=
ATLAS_RABBITMQ_URL=
ATLAS_CELERY_ALWAYS_EAGER=true

ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATLAS_ALLOWED_HOSTS=*
ATLAS_RATE_LIMIT_PER_MINUTE=240
ATLAS_MAX_UPLOAD_MB=25

# Scan controls
ATLAS_REQUIRE_SCAN_AUTHORIZATION=true
ATLAS_SCANNER_TIMEOUT_SECONDS=300

# AI provider: none | openai | anthropic | ollama | openai_compatible
# "none" produces deterministic heuristic triage labelled as heuristic.
ATLAS_AI_PROVIDER=none
ATLAS_AI_BASE_URL=
ATLAS_AI_API_KEY=
ATLAS_AI_MODEL=gpt-4o-mini
ATLAS_AI_TIMEOUT_SECONDS=60
ATLAS_AI_MAX_TOKENS=1600

# Identity provider (optional)
ATLAS_OIDC_ENABLED=false
ATLAS_OIDC_ISSUER=
ATLAS_OIDC_CLIENT_ID=
ATLAS_OIDC_JWKS_URL=

# Demo environment — synthetic data only, never enable in production.
ATLAS_DEMO_MODE=false
ATLAS_SEED_DEMO_DATA=false

# Intelligence providers
ATLAS_OSV_API_URL=https://api.osv.dev/v1
ATLAS_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
ATLAS_NVD_API_KEY=

# Docker Compose credentials
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-change-me
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=atlas-change-me
GRAFANA_USER=admin
GRAFANA_PASSWORD=atlas-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=atlas-change-me
